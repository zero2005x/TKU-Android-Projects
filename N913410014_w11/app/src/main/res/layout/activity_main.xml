<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <RelativeLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- 轉換結果標題 -->
        <TextView
            android:id="@+id/convertResultTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="轉換結果:"
            android:textColor="#0000FF"
            android:textSize="20sp" />

        <!-- 輸入溫度標籤 -->
        <TextView
            android:id="@+id/enterTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/convertResultTextView"
            android:layout_marginTop="10dp"
            android:text="輸入溫度"
            android:textSize="24sp" />

        <!-- 溫度輸入框 -->
        <EditText
            android:id="@+id/userInputEditText"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_below="@+id/convertResultTextView"
            android:layout_toRightOf="@+id/enterTextView"
            android:layout_marginTop="10dp"
            android:layout_marginLeft="10dp"
            android:hint="請輸入數值"
            android:inputType="numberDecimal|numberSigned"
            android:textSize="18sp" />

        <!-- 攝氏/華氏選擇 -->
        <RadioGroup
            android:id="@+id/conversionTypeRadioGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/convertResultTextView"
            android:layout_toRightOf="@+id/userInputEditText"
            android:layout_marginTop="10dp"
            android:layout_marginLeft="10dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/celsiusToFahrenheitRadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="攝氏"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/fahrenheitToCelsiusRadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="華氏"
                android:textSize="16sp" />
        </RadioGroup>

        <!-- 確定和清除按鈕 -->
        <LinearLayout
            android:id="@+id/buttonLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/enterTextView"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/confirmButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="確定"
                android:textSize="16sp" />

            <Button
                android:id="@+id/clearButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="清除"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- 汽水選項 -->
        <RelativeLayout
            android:id="@+id/softDrinkRelativeLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/buttonLayout"
            android:layout_marginTop="20dp">

            <CheckBox
                android:id="@+id/softDrinkCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="汽水"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/softDrinkImageView"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_toRightOf="@+id/softDrinkCheckBox"
                android:layout_marginStart="5dp"
                android:src="@drawable/softdrink" />

            <RadioGroup
                android:id="@+id/softDrinkSizeRadioGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_softdrink_s"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="小" />

                <RadioButton
                    android:id="@+id/rb_softdrink_m"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="中" />

                <RadioButton
                    android:id="@+id/rb_softdrink_l"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="大" />
            </RadioGroup>
        </RelativeLayout>

        <!-- 漢堡選項 -->
        <RelativeLayout
            android:id="@+id/ll_hamburger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/softDrinkRelativeLayout"
            android:layout_marginTop="10dp">

            <CheckBox
                android:id="@+id/hamburgerCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="漢堡"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/hamburgerImageView"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_toRightOf="@+id/hamburgerCheckBox"
                android:layout_marginStart="5dp"
                android:src="@drawable/hamburger" />

            <RadioGroup
                android:id="@+id/hamburgerSizeRadioGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_hamburger_s"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="小" />

                <RadioButton
                    android:id="@+id/rb_hamburger_m"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="中" />

                <RadioButton
                    android:id="@+id/rb_hamburger_l"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="大" />
            </RadioGroup>
        </RelativeLayout>

        <!-- 薯條選項 -->
        <RelativeLayout
            android:id="@+id/ll_frenchfry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/ll_hamburger"
            android:layout_marginTop="10dp">

            <CheckBox
                android:id="@+id/frenchfryCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="薯條"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/frenchfryImageView"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_toRightOf="@+id/frenchfryCheckBox"
                android:layout_marginStart="5dp"
                android:src="@drawable/frenchfry" />

            <RadioGroup
                android:id="@+id/frenchfrySizeRadioGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_frenchfry_s"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="小" />

                <RadioButton
                    android:id="@+id/rb_frenchfry_m"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="中" />

                <RadioButton
                    android:id="@+id/rb_frenchfry_l"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="大" />
            </RadioGroup>
        </RelativeLayout>

        <!-- 濃湯選項 -->
        <RelativeLayout
            android:id="@+id/ll_soup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/ll_frenchfry"
            android:layout_marginTop="10dp">

            <CheckBox
                android:id="@+id/soupCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="濃湯"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/soupImageView"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_toRightOf="@+id/soupCheckBox"
                android:layout_marginStart="5dp"
                android:src="@drawable/soup" />

            <RadioGroup
                android:id="@+id/soupSizeRadioGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_soup_s"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="小" />

                <RadioButton
                    android:id="@+id/rb_soup_m"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="中" />

                <RadioButton
                    android:id="@+id/rb_soup_l"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="大" />
            </RadioGroup>
        </RelativeLayout>

        <!-- 咖啡選項 -->
        <RelativeLayout
            android:id="@+id/ll_coffee"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/ll_soup"
            android:layout_marginTop="10dp">

            <CheckBox
                android:id="@+id/coffeeCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="咖啡"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/coffeeImageView"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_toRightOf="@+id/coffeeCheckBox"
                android:layout_marginStart="5dp"
                android:src="@drawable/coffee" />

            <RadioGroup
                android:id="@+id/coffeeSizeRadioGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_coffee_s"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="小" />

                <RadioButton
                    android:id="@+id/rb_coffee_m"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="中" />

                <RadioButton
                    android:id="@+id/rb_coffee_l"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="大" />
            </RadioGroup>
        </RelativeLayout>

        <!-- 結果圖片顯示區域 -->
        <HorizontalScrollView
            android:id="@+id/resultScrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/ll_coffee"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/resSoftDrinkImg"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/softdrink"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/resHamburgerImg"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/hamburger"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/resFrenchFryImg"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/frenchfry"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/resSoupImg"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/soup"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/resCoffeeImg"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/coffee"
                    android:visibility="gone" />
            </LinearLayout>
        </HorizontalScrollView>

    </RelativeLayout>
</ScrollView>